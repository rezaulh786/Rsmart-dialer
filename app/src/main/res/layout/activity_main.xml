<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <!-- মূল ইন্টারফেস -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- উপরের সার্চ বার -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:elevation="4dp">

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="🔍 Search contacts বা নম্বর খুঁজুন..."
                android:background="#F1F3F4"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textSize="16sp"
                android:textColor="#202124" />
        </LinearLayout>

        <!-- মাঝখানের অংশ (৪টি ট্যাবের ভিউ) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- ১. Home / Recent Calls -->
            <LinearLayout
                android:id="@+id/layoutRecents"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="সাম্প্রতিক কল তালিকা ( ক্লিক করলেই কল যাবে )"
                    android:textSize="13sp"
                    android:textColor="#5F6368"
                    android:padding="8dp" />

                <ListView
                    android:id="@+id/listRecents"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="#E0E0E0"
                    android:dividerHeight="1dp" />
            </LinearLayout>

            <!-- ২. Contacts (A-Z) -->
            <LinearLayout
                android:id="@+id/layoutContacts"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="8dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="সকল কন্টাক্ট ( ক্লিক করলেই কল যাবে )"
                    android:textSize="13sp"
                    android:textColor="#5F6368"
                    android:padding="8dp" />

                <ListView
                    android:id="@+id/listContacts"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="#E0E0E0"
                    android:dividerHeight="1dp" />
            </LinearLayout>

            <!-- ৩. Keypad (ডায়ালপ্যাড) -->
            <LinearLayout
                android:id="@+id/layoutKeypad"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="bottom"
                android:padding="16dp"
                android:background="#FFFFFF"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/tvDialNumber"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        android:textColor="#202124"
                        android:hint="নম্বর তুলুন" />

                    <Button
                        android:id="@+id/btnBackspace"
                        android:layout_width="60dp"
                        android:layout_height="50dp"
                        android:text="⌫"
                        android:textSize="20sp"
                        android:backgroundTint="#E8EAED"
                        android:textColor="#202124" />
                </LinearLayout>

                <!-- বাটন সারি ১-৩ -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/btn1" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:layout_margin="4dp" android:text="1" android:textSize="24sp" android:backgroundTint="#F1F3F4" android:textColor="#202124"/>
                    <Button android:id="@+id/btn2" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:layout_margin="4dp" android:text="2" android:textSize="24sp" android:backgroundTint="#F1F3F4" android:textColor="#202124"/>
                    <Button android:id="@+id/btn3" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:layout_margin="4dp" android:text="3" android:textSize="24sp" android:backgroundTint="#F1F3F4" android:textColor="#202124"/>
                </LinearLayout>

                <!-- বাটন সারি ৪-৬ -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/btn4" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:layout_margin="4dp" android:text="4" android:textSize="24sp" android:backgroundTint="#F1F3F4" android:textColor="#202124"/>
                    <Button android:id="@+id/btn5" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:layout_margin="4dp" android:text="5" android:textSize="24sp" android:backgroundTint="#F1F3F4" android:textColor="#202124"/>
                    <Button android:id="@+id/btn6" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:layout_margin="4dp" android:text="6" android:textSize="24sp" android:backgroundTint="#F1F3F4" android:textColor="#202124"/>
                </LinearLayout>

                <!-- বাটন সারি ৭-৯ -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/btn7" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:layout_margin="4dp" android:text="7" android:textSize="24sp" android:backgroundTint="#F1F3F4" android:textColor="#202124"/>
                    <Button android:id="@+id/btn8" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:layout_margin="4dp" android:text="8" android:textSize="24sp" android:backgroundTint="#F1F3F4" android:textColor="#202124"/>
                    <Button android:id="@+id/btn9" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:layout_margin="4dp" android:text="9" android:textSize="24sp" android:backgroundTint="#F1F3F4" android:textColor="#202124"/>
                </LinearLayout>

                <!-- বাটন সারি * ০ # -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/btnStar" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:layout_margin="4dp" android:text="*" android:textSize="24sp" android:backgroundTint="#F1F3F4" android:textColor="#202124"/>
                    <Button android:id="@+id/btn0" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:layout_margin="4dp" android:text="0" android:textSize="24sp" android:backgroundTint="#F1F3F4" android:textColor="#202124"/>
                    <Button android:id="@+id/btnHash" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:layout_margin="4dp" android:text="#" android:textSize="24sp" android:backgroundTint="#F1F3F4" android:textColor="#202124"/>
                </LinearLayout>

                <Button
                    android:id="@+id/btnCall"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="12dp"
                    android:text="📞 Call Now"
                    android:textSize="20sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#1A73E8" />
            </LinearLayout>

            <!-- ৪. Recordings (অটো রেকর্ড তালিকা) -->
            <LinearLayout
                android:id="@+id/layoutRecordings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="8dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚡ অটো কল রেকর্ডিং তালিকা (ক্লিক করলে বাজবে)"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#34A853"
                    android:padding="8dp" />

                <ListView
                    android:id="@+id/listRecordings"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="#E0E0E0"
                    android:dividerHeight="1dp" />
            </LinearLayout>

        </FrameLayout>

        <!-- নিচের নেভিগেশন বার (Home, Contacts, Keypad, Records) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:orientation="horizontal"
            android:background="#FFFFFF"
            android:elevation="12dp"
            android:padding="4dp">

            <Button
                android:id="@+id/tabRecents"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:text="🏠\nHome"
                android:textSize="11sp"
                android:backgroundTint="#E8F0FE"
                android:textColor="#1A73E8" />

            <Button
                android:id="@+id/tabContacts"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:text="👤\nContacts"
                android:textSize="11sp"
                android:backgroundTint="#FFFFFF"
                android:textColor="#5F6368" />

            <Button
                android:id="@+id/tabKeypad"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:text="🔢\nKeypad"
                android:textSize="11sp"
                android:backgroundTint="#FFFFFF"
                android:textColor="#5F6368" />

            <Button
                android:id="@+id/tabRecordings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:text="🎙️\nRecords"
                android:textSize="11sp"
                android:backgroundTint="#FFFFFF"
                android:textColor="#5F6368" />
        </LinearLayout>

    </LinearLayout>

    <!-- ইনকামিং ও রানিং কলের স্ক্রিন (কল আসলে বা কল চলাকালীন ভেসে উঠবে) -->
    <LinearLayout
        android:id="@+id/layoutInCall"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:background="#1E293B"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvCallStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="কল আসছে..."
            android:textSize="20sp"
            android:textColor="#38BDF8"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvCallerNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="01XXXXXXXXX"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvRecStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔴 অটো কল রেকর্ডিং সক্রিয়"
            android:textSize="15sp"
            android:textColor="#4ADE80"
            android:layout_marginBottom="60dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnAnswerCall"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:text="📞 রিসিভ"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#22C55E" />

            <Button
                android:id="@+id/btnSpeaker"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:text="🔊 স্পিকার"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#475569" />

            <Button
                android:id="@+id/btnEndCall"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:text="❌ কেটে দিন"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#EF4444" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
